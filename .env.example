# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
#
# Everything here is optional in the sense that the app still boots without it;
# the feature that needs it degrades instead. What each one costs when unset is
# noted below.

# ── Database (Neon Postgres) ──────────────────────────────────────────────────
# Storage of record for the /board kanban and its comments.
# Use the POOLED endpoint (host contains `-pooler`) — that is what the app runs
# through. Unset: /board returns 503 and the page shows its error state.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Optional. Only the Prisma CLI uses this — migrations need a direct session,
# because PgBouncer's transaction pooling breaks the advisory locks the schema
# engine relies on. Leave it unset and prisma.config.ts derives it from
# DATABASE_URL by dropping the `-pooler` suffix, which is Neon's convention.
# Set it explicitly if your host doesn't follow that pattern.
# DIRECT_DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ── Board editing ─────────────────────────────────────────────────────────────
# The passphrase the /board padlock asks for. Any string; it is compared in
# constant time against a SHA-256 digest, so there is no format requirement.
# Unset: the board is permanently read-only and unlocking returns 503.
BOARD_SECRET="choose-a-long-random-passphrase"

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
# Rate limiting and the view/visit counters. Not the board's storage.
# Unset: rate limiting fails OPEN (requests are allowed) and view counts read as
# zero. Fine locally; set both in production.
UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxx"

# ── Contact form (Resend) ─────────────────────────────────────────────────────
# Unset: /api/contact logs an error and the form reports a failure.
RESEND_API_KEY="re_xxxx"

# ── GitHub contributions graph ────────────────────────────────────────────────
# Optional override for the contributions data source; the route falls back to
# a default when unset.
# GITHUB_CONTRIBUTIONS_API_URL="https://example.com/contributions"
